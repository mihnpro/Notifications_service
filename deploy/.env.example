# PostgreSQL
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_DB=notifications
POSTGRES_PORT=5433

# RabbitMQ
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Frontend (public UI entrypoint)
FRONTEND_PORT=80
# Leave empty to use nginx reverse proxy at /api/ (recommended).
# Set to an absolute URL only if you bypass nginx (e.g. direct Vite dev server).
# FRONTEND_VITE_API_BASE_URL=

# Optional API gateway profile port (`--profile api-gateway`).
API_GATEWAY_PORT=8080

# API
API_PORT=8000
AUTH_JWT_SECRET=dev-insecure-jwt-secret-change-me

# Recovery
RECOVERY_PORT=8081
RECOVERY_INSTANCE_ID=recover-default

# Provider mock
PROVIDER_SUCCESS_RATE=0.7
PROVIDER_MIN_DELAY=0.05
PROVIDER_MAX_DELAY=0.5
