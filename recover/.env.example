# Copy to .env for local dev. Все настройки через env (pydantic-settings).
# Pattern: RECOVER__<SECTION>__<FIELD> (двойное подчёркивание = вложенность)

RECOVER__INSTANCE_ID=recover-1
RECOVER__DB__URL=postgresql+asyncpg://notifications:notifications@localhost:5433/notifications
RECOVER__RMQ__URL=amqp://notifications:notifications@localhost:5672/%2Fnotifications
RECOVER__RMQ__ENABLED=false
RECOVER__SERVER__BIND=0.0.0.0:8080
RECOVER__TELEMETRY__LOG_LEVEL=INFO
RECOVER__TELEMETRY__LOG_FORMAT=json
RECOVER__REGIONS__IDS=["default"]
