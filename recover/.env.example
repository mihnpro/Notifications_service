# Copy to .env for local dev. All env vars override config/default.toml via figment.
# Pattern: APP__<SECTION>__<FIELD> (двойное подчёркивание = вложенность)

APP__INSTANCE_ID=recover-1
APP__DB__URL=postgres://notif:notif@localhost:5432/notif
APP__RMQ__URL=amqp://guest:guest@localhost:5672/%2f
APP__RMQ__ENABLED=false
APP__SERVER__BIND=0.0.0.0:8080
APP__TELEMETRY__LOG_LEVEL=info,sqlx=warn,lapin=warn
APP__TELEMETRY__LOG_FORMAT=json
